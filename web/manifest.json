{
  "name": "nKount - Nepali Accounting Software",
  "short_name": "nKount",
  "description": "Simple, modern, and IRD-compliant accounting software for Nepali businesses",
  "start_url": "/nKount/",
  "display": "standalone",
  "background_color": "#FDFBF8",
  "theme_color": "#8B5CF6",
  "orientation": "portrait-primary",
  "scope": "/nKount/",
  
  "icons": [
    {
      "src": "/favicon.png",
      "sizes": "16x16 32x32 48x48 64x64 128x128",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "apple touch icon"
    },
    {
      "src": "/icons/icon-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  
  "screenshots": [
    {
      "src": "/screenshots/screenshot-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "nKount Dashboard"
    },
    {
      "src": "/screenshots/screenshot-2.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "nKount Mobile View"
    }
  ],
  
  "shortcuts": [
    {
      "name": "New Invoice",
      "short_name": "New Invoice",
      "description": "Create a new invoice",
      "url": "/nKount/transactions?type=sale",
      "icons": [
        {
          "src": "/icons/new-invoice.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View Dashboard",
      "short_name": "Dashboard",
      "description": "View the dashboard",
      "url": "/nKount/",
      "icons": [
        {
          "src": "/icons/dashboard.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  
  "related_applications": [],
  "prefer_related_applications": false,
  
  "iarc_protocol_allowlist": [
    "https://*"
  ],
  
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  
  "protocol_handlers": [
    {
      "protocol": "web+nkount",
      "url": "/nKount/handle-protocol?protocol=%s"
    }
  ],
  
  "share_target": {
    "action": "/nKount/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  }
}
